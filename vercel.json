{
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "includeFiles": ".sync_data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__api_path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
