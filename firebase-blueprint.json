{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "note": {
          "type": "string",
          "description": "Administrative note.",
          "minLength": 0,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "note", "createdAt", "updatedAt"]
    },
    "WorkspaceManifest": {
      "title": "WorkspaceManifest",
      "description": "Master gate and deterministic chunk manifest for multi-device synchronization.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "Workspace identifier.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Workspace display title.",
          "minLength": 1,
          "maxLength": 200
        },
        "ownerUid": {
          "type": "string",
          "description": "Original creator Firebase Auth UID (immutable).",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedByUid": {
          "type": "string",
          "description": "Firebase Auth UID of the user performing the latest mutation.",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "description": "Lifecycle status of the workspace.",
          "enum": ["active", "archived"],
          "minLength": 1,
          "maxLength": 32
        },
        "allowSelfJoin": {
          "type": "boolean",
          "description": "Whether verified Google accounts can register their device membership."
        },
        "serverRevision": {
          "type": "number",
          "description": "Monotonic workspace revision counter."
        },
        "metaRevision": {
          "type": "number",
          "description": "Monotonic revision for users, warehouses, and tombstones."
        },
        "materialsRevision": {
          "type": "number",
          "description": "Monotonic revision for material catalog chunks."
        },
        "materialsCount": {
          "type": "number",
          "description": "Total active material count."
        },
        "materialsChunkCount": {
          "type": "number",
          "description": "Total deterministic material chunk documents."
        },
        "materialsDigest": {
          "type": "string",
          "description": "Deterministic digest of all active materials.",
          "minLength": 1,
          "maxLength": 128
        },
        "metaDigest": {
          "type": "string",
          "description": "Deterministic digest of users, warehouses, and tombstones.",
          "minLength": 1,
          "maxLength": 128
        },
        "accountChunkCount": {
          "type": "number",
          "description": "Number of non-PII warehouse account chunks."
        },
        "warehouseChunkCount": {
          "type": "number",
          "description": "Number of non-PII warehouse chunks."
        },
        "tombstoneChunkCount": {
          "type": "number",
          "description": "Number of tombstone chunks."
        },
        "inboundIndexChunkCount": {
          "type": "number",
          "description": "Number of inbound receipt manifest index chunks."
        },
        "outboundIndexChunkCount": {
          "type": "number",
          "description": "Number of outbound receipt manifest index chunks."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "workspaceId",
        "name",
        "ownerUid",
        "updatedByUid",
        "status",
        "allowSelfJoin",
        "serverRevision",
        "metaRevision",
        "materialsRevision",
        "materialsCount",
        "materialsChunkCount",
        "materialsDigest",
        "metaDigest",
        "accountChunkCount",
        "warehouseChunkCount",
        "tombstoneChunkCount",
        "inboundIndexChunkCount",
        "outboundIndexChunkCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
